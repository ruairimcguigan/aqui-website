# --- AI Engineer Tracker (private /tracker area) ---
# The single shared password to access /tracker.
TRACKER_PASSWORD="choose-a-strong-password"
# Any long random string. Used to derive the session cookie token.
# Generate one with:  openssl rand -hex 32
TRACKER_SECRET="replace-with-a-long-random-string"

# Redis REST credentials — auto-injected into the Vercel project when you add
# the Upstash integration from the Marketplace. The Marketplace integration
# uses the KV_* names below; the code also accepts UPSTASH_REDIS_REST_* if you
# provisioned Upstash directly. You only need these locally for `next dev`.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# (Alternative direct-Upstash names, if you use those instead:)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
